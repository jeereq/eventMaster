{
  "expo": {
    "name": "EventMaster",
    "slug": "eventmaster",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "eventmaster",
    "description": "Organisez vos événements privés : invitations, RSVP, protocole jour J et plan de table.",
    "primaryColor": "#4f46e5",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#312e81"
    },
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eventmaster.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "EventMaster utilise la caméra pour scanner les QR codes des invités lors du protocole jour J.",
        "NSPhotoLibraryUsageDescription": "EventMaster peut accéder à vos photos pour partager des visuels d'événement.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4f46e5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.eventmaster.app",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "eventmaster-mobile"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Autorisez EventMaster à utiliser la caméra pour scanner les QR codes des invités."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#4f46e5",
          "sounds": []
        }
      ]
    ]
  }
}
