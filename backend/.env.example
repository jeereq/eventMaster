NODE_ENV=development
PORT=5001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eventmaster
DATABASE_SSL=disable
JWT_SECRET=replace-with-at-least-32-random-characters
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Les simulations de forfait exigent ce drapeau et restent interdites en production.
ENABLE_BILLING_MOCKS=false

# Limites par adresse IP, sur une fenêtre de 15 minutes par défaut.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# En production, TLS PostgreSQL vérifie toujours le certificat.
# PG_SSL_CA accepte un PEM (les séquences \n sont converties en retours à la ligne).
# PG_SSL_CA=
