datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  COMMERCIAL
  USER
}

enum OrgRole {
  MANAGER
  PROTOCOL
  COMMERCIAL
}

enum StaffRole {
  MANAGER
  PROTOCOL
}

enum RoomType {
  SIMPLE
  BANQUET
  CONFERENCE
  AMPHITHEATER
  TENT
  CUSTOM
}

enum ChairType {
  BANQUET
  FOLDING
  THEATER
  STOOL
  ARMCHAIR
  WHEELCHAIR
}

enum PlanType {
  FREE
  PERSONAL
  PERSONAL_50
  PERSONAL_100
  PERSONAL_200
  PERSONAL_PLUS
  STANDARD
  PREMIUM_1
  PREMIUM_2
  ENTERPRISE_1
  ENTERPRISE_2
  ENTERPRISE_3
  /** Gestionnaire de salles (catalogue lieux). */
  VENUE
  /** Prestataire de services (catalogue prestations). */
  SERVICE
  /** Salles + prestations (compte BOTH). */
  CATALOG
}

enum TenantAccountKind {
  ORGANIZER
  VENDOR
  BOTH
  CLIENT
}

enum VenuePriceUnit {
  EVENT
  DAY
  HOUR
  MINUTE
  PERSON
  QUOTA
}

enum MarketplaceInquiryStatus {
  NEW
  CONTACTED
}

enum MarketplaceBookingStatus {
  REQUESTED
  ACCEPTED
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum ServiceCategory {
  CATERING
  PHOTOGRAPHY
  VIDEO
  DJ
  DECORATION
  SECURITY
  FLORIST
  TRANSPORT
  MC
  OTHER
}

model Tenant {
  id            String     @id @default(uuid())
  name          String
  plan          PlanType   @default(FREE)
  stripeCustId  String?
  licenseActive Boolean    @default(true)
  licenseExpiresAt DateTime?
  licenseExpiryWarningFor DateTime?
  licenseKey    String?
  referredByCommercialId String?
  referredByCommercial   User? @relation("CommercialReferral", fields: [referredByCommercialId], references: [id], onDelete: SetNull)
  referredByOrgUserId    String?
  referredByOrgUser      User? @relation("OrgCommercialReferral", fields: [referredByOrgUserId], references: [id], onDelete: SetNull)
  defaultOrgCommercialCommissionRate Float @default(0.30)
  /** Couleurs de marque org : { primary, accent, sidebar? } */
  branding      Json?
  /** ORGANIZER = SaaS événement (défaut). VENDOR = offre salles/prestas. BOTH = les deux. CLIENT = réserve sans SaaS. */
  accountKind   TenantAccountKind @default(ORGANIZER)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  users         User[]
  events        Event[]
  templates     Template[]
  subscriptionRequests SubscriptionRequest[]
  rooms         OrganizationRoom[]
  commercialCommissions CommercialCommission[]
  platformInvoices      PlatformInvoice[]
  vendorProfile VendorProfile?
  venueListings VenueListing[]
  serviceOfferings ServiceOffering[]
  marketplaceInquiries MarketplaceInquiry[] @relation("InquiryFromTenant")
  vendorBookings MarketplaceBooking[] @relation("BookingVendor")
  organizerBookings MarketplaceBooking[] @relation("BookingOrganizer")
  
  managerId     String?
  manager       User?      @relation("TenantManager", fields: [managerId], references: [id])
}

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  passwordHash  String
  name          String?
  phone         String?
  /** Indicatif pays dédié, ex. +243 — saisi séparément du numéro national */
  phoneCountryCode String?
  role          Role       @default(USER)
  orgRole       OrgRole?
  tenantId      String?
  tenant        Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  isEmailVerified Boolean  @default(false)
  verificationToken String?
  otpHash           String?
  otpExpiresAt      DateTime?
  verificationMethod String?  // EMAIL | WHATSAPP
  termsAcceptedAt   DateTime?
  privacyAcceptedAt DateTime?
  termsVersion      String?
  privacyVersion    String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  referralCode   String?    @unique
  commissionRate Float?
  managedTenants Tenant[]  @relation("TenantManager")
  referredTenants Tenant[] @relation("CommercialReferral")
  orgCommercialReferrals Tenant[] @relation("OrgCommercialReferral")
  comments       EventComment[]
  legalAcceptances LegalAcceptance[]
  eventStaff     EventStaff[]
  roomStaff      RoomStaff[]
  guestCheckIns  Guest[]   @relation("GuestCheckIns")
  guestSeatVerifications Guest[] @relation("GuestSeatVerifications")
  protocolNotes  GuestProtocolNote[]
  commercialCommissions CommercialCommission[]
  platformNotifications PlatformNotification[]
  pushDeviceTokens      PushDeviceToken[]
}

model Event {
  id                String       @id @default(uuid())
  tenantId          String
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roomId            String?
  room              OrganizationRoom? @relation(fields: [roomId], references: [id], onDelete: SetNull)
  title             String
  description       String?
  date              DateTime
  location          String
  reminderFrequency String?      @default("NONE") // NONE, DAILY, EVERY_3_DAYS, EVERY_5_DAYS, WEEKLY
  latitude          Float?
  longitude         Float?
  tablePlan         Json?        // Added for visual table planning
  guestGuidelines   Json?        // Dress code & practical recommendations for guests
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  guests      Guest[]
  invitations Invitation[]
  shares      GuestShare[]
  posts       EventPost[]
  staff       EventStaff[]
  marketplaceInquiries MarketplaceInquiry[]
  marketplaceBookings MarketplaceBooking[]
}

model Guest {
  id          String       @id @default(uuid())
  eventId     String
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String
  email       String
  phone       String?
  /** Indicatif pays dédié, ex. +243 */
  phoneCountryCode String?
  category    String?
  rsvp        String       @default("PENDING") // PENDING, ACCEPTED, DECLINED
  preferences Json?
  checkedInAt DateTime?
  checkedInByUserId String?
  checkedInBy User?        @relation("GuestCheckIns", fields: [checkedInByUserId], references: [id], onDelete: SetNull)
  seatVerified Boolean     @default(false)
  seatVerifiedAt DateTime?
  seatVerifiedByUserId String?
  seatVerifiedBy User?     @relation("GuestSeatVerifications", fields: [seatVerifiedByUserId], references: [id], onDelete: SetNull)
  seatingInvitationPdfUrl       String?
  seatingInvitationPdfPublicId  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  shares      GuestShare[]
  comments    EventComment[]
  legalAcceptances LegalAcceptance[]
  protocolNotes GuestProtocolNote[]

  @@unique([eventId, email])
  @@index([phone])
}

model GuestProtocolNote {
  id        String   @id @default(uuid())
  guestId   String
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  @@index([guestId])
}

model CommercialCommission {
  id               String   @id @default(uuid())
  commercialId     String
  commercial       User     @relation(fields: [commercialId], references: [id], onDelete: Cascade)
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan             PlanType
  invoiceAmount    Float
  commissionRate   Float    @default(0.30)
  commissionAmount Float
  billingPeriod    String
  source           String
  platformInvoiceId String?
  platformInvoice   PlatformInvoice? @relation(fields: [platformInvoiceId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())

  @@unique([commercialId, tenantId, billingPeriod])
  @@index([commercialId])
  @@index([platformInvoiceId])
}

enum InvoiceType {
  SUBSCRIPTION_APPROVAL
  RENEWAL
  PAYMENT
}

enum InvoiceStatus {
  SENT
  PAID
  PENDING
}

model PlatformInvoice {
  id                    String        @id @default(uuid())
  invoiceNumber         String        @unique
  tenantId              String
  tenant                Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan                  PlanType
  amount                Float
  currency              String        @default("FC")
  type                  InvoiceType
  status                InvoiceStatus @default(SENT)
  durationDays          Int?
  periodStart           DateTime?
  periodEnd             DateTime?
  billingPeriod         String
  subscriptionRequestId String?       @unique
  subscriptionRequest   SubscriptionRequest? @relation(fields: [subscriptionRequestId], references: [id], onDelete: SetNull)
  recipientEmails       Json
  details               Json?
  sentAt                DateTime?
  createdAt             DateTime      @default(now())
  commercialCommissions CommercialCommission[]

  @@index([tenantId])
  @@index([billingPeriod])
  @@index([type])
  @@index([createdAt])
}

model Template {
  id            String       @id @default(uuid())
  tenantId      String?
  tenant        Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  content       Json
  showOnLanding Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  invitations Invitation[]
}

model Invitation {
  id          String       @id @default(uuid())
  eventId     String
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  templateId  String?
  template    Template?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
  subject     String
  body        String
  channel     String       // EMAIL, LINK, QR
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model GuestShare {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guestId   String
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  message   String?
  photo     String?  // Base64 string (legacy)
  photos    Json?    // Array of Base64 strings for multiple photos
  createdAt DateTime @default(now())
}

model EventPost {
  id        String         @id @default(uuid())
  eventId   String
  event     Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  content   String?
  mediaUrl  String?        // Base64 string (legacy)
  mediaUrls Json?          // Array of objects { url: string, type: 'IMAGE' | 'VIDEO' }
  mediaType String?        // IMAGE, VIDEO, TEXT (legacy)
  likes     Json?          // Array of guest/user IDs who liked the post
  createdAt DateTime       @default(now())
  comments  EventComment[]
}

model EventComment {
  id         String    @id @default(uuid())
  postId     String
  post       EventPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorName String
  guestId    String?
  guest      Guest?    @relation(fields: [guestId], references: [id], onDelete: SetNull)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  content    String
  createdAt  DateTime  @default(now())
}

enum SubscriptionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model SubscriptionRequest {
  id                     String                    @id @default(uuid())
  tenantId               String
  tenant                 Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestedPlan          PlanType
  durationDays           Int                       @default(30)
  proofOfPayment         String?
  status                 SubscriptionRequestStatus @default(PENDING)
  specialDiscountPercent Float?
  baseAmount             Float?
  approvedAmount         Float?
  platformInvoice        PlatformInvoice?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
}

model GuestMessageTemplate {
  id          String   @id @default(uuid())
  type        String   @unique
  name        String
  description String?
  channel     String   @default("WHATSAPP")
  subject     String?
  body        String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LegalAcceptance {
  id               String   @id @default(uuid())
  subjectType      String   // USER | GUEST
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestId          String?
  guest            Guest?   @relation(fields: [guestId], references: [id], onDelete: Cascade)
  normalizedEmail  String?
  normalizedPhone  String?
  documentType     String   // TERMS | PRIVACY
  documentVersion  String
  ipAddress        String?
  userAgent        String?
  acceptedAt       DateTime @default(now())

  @@index([normalizedEmail])
  @@index([normalizedPhone])
  @@index([userId])
  @@index([guestId])
  @@index([subjectType, documentType, documentVersion])
}

model OrganizationRoom {
  id               String   @id @default(uuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  capacity         Int?
  floor            String?
  location         String?
  roomType         RoomType @default(SIMPLE)
  layoutBlueprint  Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  events      Event[]
  staff       RoomStaff[]
  venueListing VenueListing?

  @@index([tenantId])
}

model VendorProfile {
  id          String   @id @default(uuid())
  tenantId    String   @unique
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slug        String   @unique
  displayName String
  city        String?
  bio         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  offerings ServiceOffering[]
}

model VenueListing {
  id           String         @id @default(uuid())
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roomId       String         @unique
  room         OrganizationRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  slug         String         @unique
  isPublic     Boolean        @default(false)
  headline     String?
  city         String?
  commune      String?
  neighborhood String?
  address      String?
  latitude     Float?
  longitude    Float?
  priceFromFc  Int?
  priceUnit    VenuePriceUnit @default(EVENT)
  quotaMin     Int?
  quotaMax     Int?
  photos       Json?
  blockedDates Json?
  publishedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  inquiries MarketplaceInquiry[]
  bookings  MarketplaceBooking[]

  @@index([isPublic, city])
  @@index([isPublic, commune])
  @@index([tenantId])
}

model MarketplaceInquiry {
  id          String                    @id @default(uuid())
  listingId   String?
  listing     VenueListing?             @relation(fields: [listingId], references: [id], onDelete: Cascade)
  offeringId  String?
  offering    ServiceOffering?          @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  eventId     String?
  event       Event?                    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  fromName    String
  fromEmail   String
  fromPhone   String?
  eventDate   DateTime?
  guestCount  Int?
  message     String
  status      MarketplaceInquiryStatus  @default(NEW)
  fromTenantId String?
  fromTenant   Tenant?                  @relation("InquiryFromTenant", fields: [fromTenantId], references: [id], onDelete: SetNull)
  createdAt   DateTime                  @default(now())

  @@index([listingId, createdAt])
  @@index([offeringId, createdAt])
  @@index([fromEmail])
}

model MarketplaceBooking {
  id                 String                    @id @default(uuid())
  listingId          String?
  listing            VenueListing?             @relation(fields: [listingId], references: [id], onDelete: Cascade)
  offeringId         String?
  offering           ServiceOffering?          @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  inquiryId          String?                   @unique
  vendorTenantId     String
  vendorTenant       Tenant                    @relation("BookingVendor", fields: [vendorTenantId], references: [id], onDelete: Cascade)
  organizerTenantId  String?
  organizerTenant    Tenant?                   @relation("BookingOrganizer", fields: [organizerTenantId], references: [id], onDelete: SetNull)
  organizerUserId    String?
  eventId            String?
  event              Event?                    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  eventDate          DateTime
  guestCount         Int?
  amountFc           Int
  depositFc          Int
  commissionRate     Float                     @default(0.08)
  commissionFc       Int
  status             MarketplaceBookingStatus  @default(REQUESTED)
  depositMarkedAt    DateTime?
  notes              String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@index([vendorTenantId, status])
  @@index([organizerTenantId, status])
  @@index([eventDate])
}

model ServiceOffering {
  id                String           @id @default(uuid())
  tenantId          String
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendorProfileId   String
  vendorProfile     VendorProfile    @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  slug              String           @unique
  category          ServiceCategory
  title             String
  description       String?
  city              String?
  commune           String?
  neighborhood      String?
  coverageRadiusKm  Int?
  travels           Boolean          @default(true)
  latitude          Float?
  longitude         Float?
  priceFromFc       Int?
  priceUnit         VenuePriceUnit   @default(EVENT)
  quotaMin          Int?
  quotaMax          Int?
  photos            Json?
  blockedDates      Json?
  isPublic          Boolean          @default(false)
  publishedAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  inquiries MarketplaceInquiry[]
  bookings  MarketplaceBooking[]

  @@index([isPublic, category])
  @@index([tenantId])
}

model RoomStaff {
  id        String           @id @default(uuid())
  roomId    String
  room      OrganizationRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffRole StaffRole
  createdAt DateTime         @default(now())

  @@unique([roomId, userId])
  @@index([userId])
}

model EventStaff {
  id        String    @id @default(uuid())
  eventId   String
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffRole StaffRole
  createdAt DateTime  @default(now())

  @@unique([eventId, userId])
  @@index([userId])
}

model PlatformNotification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model PushDeviceToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/** Journal des actions Super Admin / Commercial plateforme (pas de FK : conserve les traces après suppression). */
model AdminAuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actorEmail String
  actorRole  String
  action     String
  targetType String
  targetId   String?
  tenantId   String?
  summary    String
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([tenantId])
  @@index([actorId])
  @@index([action])
}

/** Catalogue des forfaits / abonnements (source de vérité pour quotas, prix, features). */
model SubscriptionPlan {
  id                  PlanType @id
  name                String
  price               String
  monthlyPriceFc      Int
  promoActive         Boolean  @default(false)
  promoPrice          String?
  promoMonthlyPriceFc Int?
  promoLabel          String?
  description         String
  maxEvents           Int
  maxGuests           Int
  maxTemplates        Int
  maxRooms            Int
  maxServices         Int      @default(9999)
  maxOrgManagers      Int
  customTemplates     Boolean  @default(false)
  mockupOcr           Boolean  @default(false)
  protocolQr          Boolean  @default(false)
  seatNotifications   Boolean  @default(false)
  roomThemesFixtures  Boolean  @default(false)
  adminReports        Boolean  @default(false)
  roomEditorLevel     String   @default("basic")
  commercialNetwork   Boolean  @default(false)
  supportLevel        String   @default("community")
  /** B2B | B2C | VENUE | SERVICE | CATALOG */
  audience            String   @default("B2B")
  sortOrder           Int      @default(0)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
