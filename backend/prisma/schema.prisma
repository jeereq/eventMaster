datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  COMMERCIAL
  USER
}

enum OrgRole {
  MANAGER
  PROTOCOL
  COMMERCIAL
}

enum StaffRole {
  MANAGER
  PROTOCOL
}

enum RoomType {
  SIMPLE
  BANQUET
  CONFERENCE
  AMPHITHEATER
  TENT
  CUSTOM
}

enum ChairType {
  BANQUET
  FOLDING
  THEATER
  STOOL
  ARMCHAIR
  WHEELCHAIR
}

enum PlanType {
  FREE
  PERSONAL
  PERSONAL_50
  PERSONAL_100
  PERSONAL_200
  PERSONAL_PLUS
  STANDARD
  PREMIUM_1
  PREMIUM_2
  ENTERPRISE_1
  ENTERPRISE_2
  ENTERPRISE_3
  /** Gestionnaire de salles (catalogue lieux). */
  VENUE
  /** Prestataire de services (catalogue prestations). */
  SERVICE
  /** Salles + prestations (compte BOTH). */
  CATALOG
}

enum TenantAccountKind {
  ORGANIZER
  VENDOR
  BOTH
  CLIENT
}

/** Période de base (mois ou trimestre) vs annuel 365 j. */
enum TenantBillingCycle {
  PERIOD
  ANNUAL
}

enum VenuePriceUnit {
  EVENT
  DAY
  HOUR
  MINUTE
  PERSON
  QUOTA
}

enum MarketplaceInquiryStatus {
  NEW
  CONTACTED
}

enum MarketplaceBookingStatus {
  REQUESTED
  ACCEPTED
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum ServiceCategory {
  CATERING
  PHOTOGRAPHY
  VIDEO
  DJ
  DECORATION
  SECURITY
  FLORIST
  TRANSPORT
  MC
  BEAUTY_HAIR
  EVENT_PLANNER
  ENTERTAINMENT
  OFFICIANT
  CHILDCARE
  AV_TECHNICIAN
  STATIONERY
  OTHER
  RENTAL_CLOTHING_MEN
  RENTAL_CLOTHING_WOMEN
  RENTAL_CLOTHING_CHILD
  RENTAL_CAR
  RENTAL_MOTO
  RENTAL_EQUIPMENT
  RENTAL_FURNITURE
  RENTAL_AV
  RENTAL_TABLEWARE
  RENTAL_DECOR
  RENTAL_TENT
}

model Tenant {
  id            String     @id @default(uuid())
  name          String
  plan          PlanType   @default(FREE)
  stripeCustId  String?
  licenseActive Boolean    @default(true)
  licenseExpiresAt DateTime?
  licenseExpiryWarningFor DateTime?
  licenseKey    String?
  referredByCommercialId String?
  referredByCommercial   User? @relation("CommercialReferral", fields: [referredByCommercialId], references: [id], onDelete: SetNull)
  referredByOrgUserId    String?
  referredByOrgUser      User? @relation("OrgCommercialReferral", fields: [referredByOrgUserId], references: [id], onDelete: SetNull)
  /** Taux 1er paiement des commerciaux org (0.30 = 30 %). */
  defaultOrgCommercialCommissionRate Float @default(0.30)
  /** Taux des paiements suivants (0.20 = 20 %). */
  defaultOrgCommercialRenewalCommissionRate Float @default(0.20)
  /** Couleurs de marque org : { primary, accent, sidebar? } */
  branding      Json?
  /** ORGANIZER = SaaS événement (défaut). VENDOR = offre salles/prestas. BOTH = les deux. CLIENT = réserve sans SaaS. */
  accountKind   TenantAccountKind @default(ORGANIZER)
  /** Cycle facturé : période de base ou annuel (reprise au renouvellement auto). */
  billingCycle  TenantBillingCycle @default(PERIOD)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  users         User[]
  events        Event[]
  templates     Template[]
  subscriptionRequests SubscriptionRequest[]
  rooms         OrganizationRoom[]
  commercialCommissions CommercialCommission[]
  platformInvoices      PlatformInvoice[]
  vendorProfile VendorProfile?
  venueListings VenueListing[]
  serviceOfferings ServiceOffering[]
  marketplaceInquiries MarketplaceInquiry[] @relation("InquiryFromTenant")
  vendorBookings MarketplaceBooking[] @relation("BookingVendor")
  organizerBookings MarketplaceBooking[] @relation("BookingOrganizer")
  orgRoomAmbiences OrgRoomAmbience[]
  
  managerId     String?
  manager       User?      @relation("TenantManager", fields: [managerId], references: [id])
}

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  passwordHash  String
  name          String?
  avatarUrl     String?
  phone         String?
  /** Indicatif pays dédié, ex. +243 — saisi séparément du numéro national */
  phoneCountryCode String?
  role          Role       @default(USER)
  orgRole       OrgRole?
  tenantId      String?
  tenant        Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  isEmailVerified Boolean  @default(false)
  verificationToken String?
  otpHash           String?
  otpExpiresAt      DateTime?
  verificationMethod String?  // EMAIL | WHATSAPP
  termsAcceptedAt   DateTime?
  privacyAcceptedAt DateTime?
  termsVersion      String?
  privacyVersion    String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  referralCode   String?    @unique
  /** Taux au premier paiement (0.30 = 30 % par défaut). */
  commissionRate Float?
  /** Taux des paiements suivants (0.20 = 20 % par défaut). */
  renewalCommissionRate Float?
  managedTenants Tenant[]  @relation("TenantManager")
  referredTenants Tenant[] @relation("CommercialReferral")
  orgCommercialReferrals Tenant[] @relation("OrgCommercialReferral")
  comments       EventComment[]
  legalAcceptances LegalAcceptance[]
  eventStaff     EventStaff[]
  roomStaff      RoomStaff[]
  assignedEventTasks EventTask[] @relation("EventTaskAssignee")
  createdEventTasks  EventTask[] @relation("EventTaskCreator")
  guestCheckIns  Guest[]   @relation("GuestCheckIns")
  guestSeatVerifications Guest[] @relation("GuestSeatVerifications")
  protocolNotes  GuestProtocolNote[]
  commercialCommissions CommercialCommission[]
  commercialPayoutTransfers CommercialPayoutTransfer[]
  platformNotifications PlatformNotification[]
  notificationPreferences NotificationPreference[]
  pushDeviceTokens      PushDeviceToken[]
  listingFavorites      ListingFavorite[]
  savedEventPacks       SavedEventPack[]
  savedEventBriefs      SavedEventBrief[]
  savedRoomAmbiences    SavedRoomAmbience[]
  orgRoomAmbiences      OrgRoomAmbience[]
  ticketOrders          TicketOrder[]
  aiTokenOrders         AiTokenOrder[]
  aiSimulationRuns      AiSimulationRun[]
  aiSimulationWallets   AiSimulationWallet[]
}

model Event {
  id                String       @id @default(uuid())
  tenantId          String
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roomId            String?
  room              OrganizationRoom? @relation(fields: [roomId], references: [id], onDelete: SetNull)
  title             String
  description       String?
  date              DateTime
  /** Fin optionnelle (gestionnaire). */
  endsAt            DateTime?
  location          String
  /** WEDDING, BIRTHDAY, BAPTISM, CORPORATE, CONFERENCE, GALA, OTHER */
  eventKind         String?
  /** Nom du client / dossier (gestionnaire). */
  clientName        String?
  estimatedGuests   Int?
  dayOfContactName  String?
  dayOfContactPhone String?
  reminderFrequency String?      @default("NONE") // NONE, DAILY, EVERY_3_DAYS, EVERY_5_DAYS, WEEKLY
  latitude          Float?
  longitude         Float?
  tablePlan         Json?        // Added for visual table planning
  guestGuidelines   Json?        // Dress code & practical recommendations for guests
  /** Champs RSVP de l’événement (types + valeurs prédéfinies ou perso). */
  rsvpForm          Json?
  /** Préparation optionnelle : salle marketplace + prestataires (non bloquant). */
  eventPrep         Json?
  /** false = liste d’invités uniquement. true = fiche publique + inscription / billets. */
  isPublic          Boolean      @default(false)
  slug              String?      @unique
  publishedAt       DateTime?
  isBlockedByAdmin  Boolean      @default(false)
  adminBlockReason  String?
  ticketingEnabled  Boolean      @default(false)
  ticketPriceFc     Int          @default(0)
  /** global = prix unique ; by_zone = tarifs dans tablePlan.pricingZones */
  ticketPricingMode String       @default("global")
  ticketsTotal      Int?
  ticketsSold       Int          @default(0)
  /** Achat billet pour une place précise (plan de table requis). */
  seatSelectionEnabled Boolean   @default(false)
  /** Programme structuré (créneaux + ambiance lumière). */
  eventProgram      Json?
  themeId           String?
  /** Galerie publique (URLs Cloudinary), comme une fiche salle. */
  photos            Json?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  guests      Guest[]
  invitations Invitation[]
  shares      GuestShare[]
  posts       EventPost[]
  staff       EventStaff[]
  tasks       EventTask[]
  marketplaceInquiries MarketplaceInquiry[]
  marketplaceBookings MarketplaceBooking[]
  ticketOrders TicketOrder[]
  seatHolds    SeatHold[]

  @@index([isPublic, date])
}

model Guest {
  id          String       @id @default(uuid())
  eventId     String
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String
  email       String
  phone       String?
  /** Indicatif pays dédié, ex. +243 */
  phoneCountryCode String?
  category    String?
  rsvp        String       @default("PENDING") // PENDING, ACCEPTED, DECLINED
  preferences Json?
  checkedInAt DateTime?
  checkedInByUserId String?
  checkedInBy User?        @relation("GuestCheckIns", fields: [checkedInByUserId], references: [id], onDelete: SetNull)
  seatVerified Boolean     @default(false)
  seatVerifiedAt DateTime?
  seatVerifiedByUserId String?
  seatVerifiedBy User?     @relation("GuestSeatVerifications", fields: [seatVerifiedByUserId], references: [id], onDelete: SetNull)
  seatingInvitationPdfUrl       String?
  seatingInvitationPdfPublicId  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  shares      GuestShare[]
  comments    EventComment[]
  legalAcceptances LegalAcceptance[]
  protocolNotes GuestProtocolNote[]
  ticketOrderId String?
  ticketOrder   TicketOrder? @relation(fields: [ticketOrderId], references: [id], onDelete: SetNull)

  @@unique([eventId, email])
  @@index([phone])
}

model TicketOrder {
  id                      String    @id @default(uuid())
  eventId                 String
  event                   Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  buyerName               String
  buyerEmail              String
  buyerPhone              String?
  quantity                Int       @default(1)
  amountFc                Int
  /** Prix unitaire facturé (audit si tarifs par zone). */
  unitPriceFc             Int?
  pricingZoneId           String?
  status                  String    @default("PENDING") // PENDING, PAID, CANCELLED
  /** stripe | flexpay_card */
  paymentProvider         String?
  stripeCheckoutSessionId String?   @unique
  stripePaymentIntentId   String?
  /** orderNumber renvoyé par FlexPay Card. */
  flexPayOrderNumber      String?   @unique
  /** Référence marchand envoyée à FlexPay (= souvent id commande). */
  flexPayReference        String?
  /** Canal FlexPay (mpesa, orange, airtel, afrimoney, mastercard…). */
  flexPayChannel          String?
  /** Montant total payé par le client (incl. frais opérateur). */
  flexPayAmountCustomer   Float?
  /** Référence transaction chez l’opérateur (provider_reference). */
  flexPayProviderReference String?
  paidAt                  DateTime?
  userId                  String?
  user                    User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  /** Place(s) choisie(s) (si seatSelectionEnabled). */
  tableId                 String?
  seatIndex               Int?
  selectedSeats           Json?
  createdAt               DateTime  @default(now())
  guests                  Guest[]
  seatHolds               SeatHold[]

  @@index([eventId, status])
  @@index([buyerEmail])
  @@index([userId])
  @@index([eventId, tableId, seatIndex])
  @@index([flexPayReference])
}

/** Réservation temporaire d’un siège pendant le checkout. */
model SeatHold {
  id         String      @id @default(uuid())
  eventId    String
  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tableId    String
  seatIndex  Int
  buyerEmail String
  expiresAt  DateTime
  orderId    String?
  order      TicketOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt  DateTime    @default(now())

  @@unique([eventId, tableId, seatIndex])
  @@index([orderId])
  @@index([expiresAt])
  @@index([eventId])
}

model GuestProtocolNote {
  id        String   @id @default(uuid())
  guestId   String
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  @@index([guestId])
}

model CommercialCommission {
  id               String   @id @default(uuid())
  commercialId     String
  commercial       User     @relation(fields: [commercialId], references: [id], onDelete: Cascade)
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan             PlanType
  invoiceAmount    Float
  commissionRate   Float    @default(0.30)
  commissionAmount Float
  billingPeriod    String
  source           String
  platformInvoiceId String?
  platformInvoice   PlatformInvoice? @relation(fields: [platformInvoiceId], references: [id], onDelete: SetNull)
  paidAt           DateTime?
  paidByUserId     String?
  payoutProofUrl   String?
  payoutNote       String?
  createdAt        DateTime @default(now())

  @@unique([commercialId, tenantId, billingPeriod])
  @@index([commercialId])
  @@index([platformInvoiceId])
}

/** Session de versement FlexPay (Pay Out) pour un dossier commercial × période. */
model CommercialPayoutTransfer {
  id                       String   @id @default(uuid())
  /** platform | org */
  kind                     String
  commercialId             String
  commercial               User     @relation(fields: [commercialId], references: [id], onDelete: Cascade)
  /** Rempli pour les versements org (tenant payeur). */
  tenantId                 String?
  billingPeriod            String
  amountFc                 Int
  phone                    String
  /** PENDING | SUCCESS | FAILED */
  status                   String   @default("PENDING")
  flexPayOrderNumber       String?  @unique
  flexPayReference         String   @unique
  flexPayChannel           String?
  flexPayProviderReference String?
  initiatedByUserId        String
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([commercialId, billingPeriod, kind])
  @@index([status])
}

enum InvoiceType {
  SUBSCRIPTION_APPROVAL
  RENEWAL
  PAYMENT
}

enum InvoiceStatus {
  SENT
  PAID
  PENDING
}

model PlatformInvoice {
  id                    String        @id @default(uuid())
  invoiceNumber         String        @unique
  tenantId              String
  tenant                Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan                  PlanType
  amount                Float
  currency              String        @default("FC")
  type                  InvoiceType
  status                InvoiceStatus @default(SENT)
  durationDays          Int?
  periodStart           DateTime?
  periodEnd             DateTime?
  billingPeriod         String
  subscriptionRequestId String?       @unique
  subscriptionRequest   SubscriptionRequest? @relation(fields: [subscriptionRequestId], references: [id], onDelete: SetNull)
  recipientEmails       Json
  details               Json?
  sentAt                DateTime?
  createdAt             DateTime      @default(now())
  commercialCommissions CommercialCommission[]

  @@index([tenantId])
  @@index([billingPeriod])
  @@index([type])
  @@index([createdAt])
}

model Template {
  id            String       @id @default(uuid())
  tenantId      String?
  tenant        Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  content       Json
  showOnLanding Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  invitations Invitation[]
}

model Invitation {
  id          String       @id @default(uuid())
  eventId     String
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  templateId  String?
  template    Template?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
  subject     String
  body        String
  whatsappBody String?
  channel     String       // EMAIL, WHATSAPP, EMAIL_AND_WHATSAPP
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model GuestShare {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guestId   String
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  message   String?
  photo     String?  // Base64 string (legacy)
  photos    Json?    // Array of Base64 strings for multiple photos
  createdAt DateTime @default(now())
}

model EventPost {
  id        String         @id @default(uuid())
  eventId   String
  event     Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  content   String?
  mediaUrl  String?        // Base64 string (legacy)
  mediaUrls Json?          // Array of objects { url: string, type: 'IMAGE' | 'VIDEO' }
  mediaType String?        // IMAGE, VIDEO, TEXT (legacy)
  likes     Json?          // Array of guest/user IDs who liked the post
  /** Visible sur la fiche publique /evenements/[slug] si l’événement est public. */
  publishedOnListing Boolean @default(false)
  createdAt DateTime       @default(now())
  comments  EventComment[]
}

model EventComment {
  id         String    @id @default(uuid())
  postId     String
  post       EventPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorName String
  guestId    String?
  guest      Guest?    @relation(fields: [guestId], references: [id], onDelete: SetNull)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  content    String
  createdAt  DateTime  @default(now())
}

enum SubscriptionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model SubscriptionRequest {
  id                     String                    @id @default(uuid())
  tenantId               String
  tenant                 Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestedPlan          PlanType
  durationDays           Int                       @default(30)
  proofOfPayment         String?
  status                 SubscriptionRequestStatus @default(PENDING)
  specialDiscountPercent Float?
  baseAmount             Float?
  approvedAmount         Float?
  /** manual | flexpay_card | flexpay_mobile */
  paymentProvider        String?
  flexPayOrderNumber     String?                   @unique
  flexPayReference       String?
  /** Canal FlexPay (mpesa, orange, airtel, afrimoney, mastercard…). */
  flexPayChannel         String?
  /** Montant total payé par le client (incl. frais opérateur). */
  flexPayAmountCustomer  Float?
  /** Référence transaction chez l’opérateur (provider_reference). */
  flexPayProviderReference String?
  paidAt                 DateTime?
  platformInvoice        PlatformInvoice?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  @@index([flexPayReference])
}

model GuestMessageTemplate {
  id          String   @id @default(uuid())
  type        String   @unique
  name        String
  description String?
  channel     String   @default("WHATSAPP")
  subject     String?
  body        String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LegalAcceptance {
  id               String   @id @default(uuid())
  subjectType      String   // USER | GUEST
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestId          String?
  guest            Guest?   @relation(fields: [guestId], references: [id], onDelete: Cascade)
  normalizedEmail  String?
  normalizedPhone  String?
  documentType     String   // TERMS | PRIVACY
  documentVersion  String
  ipAddress        String?
  userAgent        String?
  acceptedAt       DateTime @default(now())

  @@index([normalizedEmail])
  @@index([normalizedPhone])
  @@index([userId])
  @@index([guestId])
  @@index([subjectType, documentType, documentVersion])
}

model OrganizationRoom {
  id               String   @id @default(uuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  capacity         Int?
  floor            String?
  location         String?
  roomType         RoomType @default(SIMPLE)
  layoutBlueprint  Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  events      Event[]
  staff       RoomStaff[]
  venueListing VenueListing?

  @@index([tenantId])
}

model VendorProfile {
  id          String   @id @default(uuid())
  tenantId    String   @unique
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slug        String   @unique
  displayName String
  city        String?
  bio         String?
  isBlockedByAdmin Boolean @default(false)
  adminBlockReason String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  offerings ServiceOffering[]
}

model VenueListing {
  id           String         @id @default(uuid())
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roomId       String         @unique
  room         OrganizationRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  slug         String         @unique
  isPublic     Boolean        @default(false)
  headline     String?
  city         String?
  commune      String?
  neighborhood String?
  address      String?
  latitude     Float?
  longitude    Float?
  priceFromFc  Int?
  priceUnit    VenuePriceUnit @default(EVENT)
  quotaMin     Int?
  quotaMax     Int?
  photos       Json?
  details      Json?
  blockedDates Json?
  isBlockedByAdmin Boolean @default(false)
  adminBlockReason String?
  publishedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  inquiries MarketplaceInquiry[]
  bookings  MarketplaceBooking[]

  @@index([isPublic, city])
  @@index([isPublic, commune])
  @@index([tenantId])
}

model MarketplaceInquiry {
  id          String                    @id @default(uuid())
  listingId   String?
  listing     VenueListing?             @relation(fields: [listingId], references: [id], onDelete: Cascade)
  offeringId  String?
  offering    ServiceOffering?          @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  eventId     String?
  event       Event?                    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  fromName    String
  fromEmail   String
  fromPhone   String?
  eventDate   DateTime?
  guestCount  Int?
  message     String
  status      MarketplaceInquiryStatus  @default(NEW)
  fromTenantId String?
  fromTenant   Tenant?                  @relation("InquiryFromTenant", fields: [fromTenantId], references: [id], onDelete: SetNull)
  createdAt   DateTime                  @default(now())

  @@index([listingId, createdAt])
  @@index([offeringId, createdAt])
  @@index([fromEmail])
}

model MarketplaceBooking {
  id                 String                    @id @default(uuid())
  listingId          String?
  listing            VenueListing?             @relation(fields: [listingId], references: [id], onDelete: Cascade)
  offeringId         String?
  offering           ServiceOffering?          @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  inquiryId          String?                   @unique
  vendorTenantId     String
  vendorTenant       Tenant                    @relation("BookingVendor", fields: [vendorTenantId], references: [id], onDelete: Cascade)
  organizerTenantId  String?
  organizerTenant    Tenant?                   @relation("BookingOrganizer", fields: [organizerTenantId], references: [id], onDelete: SetNull)
  organizerUserId    String?
  eventId            String?
  event              Event?                    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  eventDate          DateTime
  eventEndDate       DateTime?
  guestCount         Int?
  amountFc           Int
  depositFc          Int
  commissionRate     Float                     @default(0.08)
  commissionFc       Int
  commissionSettledAt DateTime?
  commissionSettledBy String?
  status             MarketplaceBookingStatus  @default(REQUESTED)
  depositMarkedAt    DateTime?
  notes              String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@index([vendorTenantId, status])
  @@index([organizerTenantId, status])
  @@index([eventDate])
}

model ServiceOffering {
  id                String           @id @default(uuid())
  tenantId          String
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendorProfileId   String
  vendorProfile     VendorProfile    @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  slug              String           @unique
  category          ServiceCategory
  title             String
  description       String?
  city              String?
  commune           String?
  neighborhood      String?
  coverageRadiusKm  Int?
  travels           Boolean          @default(true)
  latitude          Float?
  longitude         Float?
  priceFromFc       Int?
  priceUnit         VenuePriceUnit   @default(EVENT)
  quotaMin          Int?
  quotaMax          Int?
  photos            Json?
  details           Json?
  blockedDates      Json?
  isPublic          Boolean          @default(false)
  isBlockedByAdmin  Boolean          @default(false)
  adminBlockReason  String?
  publishedAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  inquiries MarketplaceInquiry[]
  bookings  MarketplaceBooking[]

  @@index([isPublic, category])
  @@index([tenantId])
}

model ListingFavorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /** venue | service */
  kind      String
  slug      String
  createdAt DateTime @default(now())

  @@unique([userId, kind, slug])
  @@index([userId])
}

model SavedEventPack {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  eventType  String
  budgetFc   Int
  city       String?
  guestCount Int?
  eventDate  DateTime?
  /** search | custom */
  source     String   @default("search")
  styleLabel String?
  totalFc    Int
  leftoverFc Int      @default(0)
  items      Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model SavedRoomAmbience {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  preset    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model OrgRoomAmbience {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  name        String
  description String?
  preset      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([createdById])
}

model SavedEventBrief {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model RoomStaff {
  id        String           @id @default(uuid())
  roomId    String
  room      OrganizationRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffRole StaffRole
  createdAt DateTime         @default(now())

  @@unique([roomId, userId])
  @@index([userId])
}

model EventStaff {
  id        String    @id @default(uuid())
  eventId   String
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffRole StaffRole
  createdAt DateTime  @default(now())

  @@unique([eventId, userId])
  @@index([userId])
}

enum EventTaskStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum EventTaskKind {
  GENERAL
  VENUE
  VENDOR
  GUESTS
  PROTOCOL
  LOGISTICS
  COMMUNICATION
  FINANCE
}

model EventTask {
  id           String          @id @default(uuid())
  eventId      String
  event        Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title        String
  notes        String?
  status       EventTaskStatus @default(OPEN)
  kind         EventTaskKind   @default(GENERAL)
  priority     Int             @default(1)
  dueAt        DateTime?
  assigneeId   String?
  assignee     User?           @relation("EventTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById  String
  createdBy    User            @relation("EventTaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  blockedById  String?
  blockedBy    EventTask?      @relation("EventTaskBlockedBy", fields: [blockedById], references: [id], onDelete: SetNull)
  blocking     EventTask[]     @relation("EventTaskBlockedBy")
  sourceKey    String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  completedAt  DateTime?
  dueRemindedAt DateTime?

  @@unique([eventId, sourceKey])
  @@index([eventId, status])
  @@index([assigneeId, status])
  @@index([blockedById])
}

model PlatformNotification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime  @default(now())
  deliveries NotificationDelivery[]

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

/** Préférences d’alerte par famille (billing, commissions, catalog, account). In-app toujours actif. */
model NotificationPreference {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  family    String
  email     Boolean  @default(true)
  whatsapp  Boolean  @default(false)
  push      Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@unique([userId, family])
  @@index([userId])
}

model NotificationDelivery {
  id             String   @id @default(uuid())
  notificationId String
  notification   PlatformNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channel        String
  status         String
  providerId     String?
  error          String?
  createdAt      DateTime @default(now())

  @@index([notificationId])
  @@index([channel, createdAt])
}

model PushDeviceToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/** Journal des actions Super Admin / Commercial plateforme (pas de FK : conserve les traces après suppression). */
model AdminAuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actorEmail String
  actorRole  String
  action     String
  targetType String
  targetId   String?
  tenantId   String?
  summary    String
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([tenantId])
  @@index([actorId])
  @@index([action])
}

/** Catalogue des forfaits / abonnements (source de vérité pour quotas, prix, features). */
model SubscriptionPlan {
  id                  PlanType @id
  name                String
  price               String
  monthlyPriceFc      Int
  promoActive         Boolean  @default(false)
  promoPrice          String?
  promoMonthlyPriceFc Int?
  promoLabel          String?
  description         String
  maxEvents           Int
  maxGuests           Int
  maxTemplates        Int
  maxRooms            Int
  maxServices         Int      @default(9999)
  maxOrgManagers      Int
  customTemplates     Boolean  @default(false)
  mockupOcr           Boolean  @default(false)
  protocolQr          Boolean  @default(false)
  seatNotifications   Boolean  @default(false)
  roomThemesFixtures  Boolean  @default(false)
  adminReports        Boolean  @default(false)
  customRsvpFields    Boolean  @default(true)
  roomEditorLevel     String   @default("basic")
  commercialNetwork   Boolean  @default(false)
  supportLevel        String   @default("community")
  /** B2B | B2C | VENUE | SERVICE | CATALOG */
  audience            String   @default("B2B")
  sortOrder           Int      @default(0)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

/** Journal idempotent des paiements réussis (notifs + audit). */
model PaymentTrace {
  id          String   @id @default(uuid())
  kind        String
  reference   String   @unique
  amountFc    Float
  currency    String   @default("CDF")
  payerUserId String?
  payerEmail  String?
  payerPhone  String?
  deviceId    String?
  summary     String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([kind, createdAt])
  @@index([payerUserId])
}

/** Solde de simulations IA par appareil (essais gratuits + jetons payés). */
model AiSimulationWallet {
  id                String   @id @default(uuid())
  deviceId          String   @unique
  userId            String?
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  freeTrialsUsed    Int      @default(0)
  bonusTokens       Int      @default(0)
  creditedOrderIds  Json     @default("[]")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
}

/** Historique des simulations IA (landing + dashboard), rattaché au compte et/ou à l’appareil. */
model AiSimulationRun {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  deviceId    String?
  source      String
  prompt      String?
  eventType   String?
  city        String?
  commune     String?
  guestCount  Int?
  budgetMaxFc Int?
  eventDate   String?
  result      Json
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([deviceId, createdAt])
}

model AiTokenOrder {
  id                       String    @id @default(uuid())
  userId                   String?
  user                     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  deviceId                 String?
  tokensCount              Int       @default(20)
  amountFc                 Float     @default(2000)
  currency                 String    @default("CDF")
  status                   String    @default("PENDING") // PENDING | PAID | FAILED | CANCELLED
  paymentMethod            String    // mobile | card
  phone                    String?
  operator                 String?
  flexPayOrderNumber       String?   @unique
  flexPayReference         String?   @unique
  flexPayChannel           String?
  flexPayAmountCustomer    Float?
  flexPayProviderReference String?
  paidAt                   DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([flexPayReference])
  @@index([userId])
  @@index([deviceId])
}

/** Réglages Super Admin (FlexPay, marque, e-mails, commissions…) — persistés hors FS éphémère. */
model PlatformConfig {
  id        String   @id @default("default")
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

