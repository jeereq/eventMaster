datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  COMMERCIAL
  USER
}

enum PlanType {
  FREE
  STANDARD
  PREMIUM
  ENTERPRISE
}

model Tenant {
  id            String     @id @default(uuid())
  name          String
  plan          PlanType   @default(FREE)
  stripeCustId  String?
  licenseActive Boolean    @default(true)
  licenseExpiresAt DateTime?
  licenseKey    String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  users         User[]
  events        Event[]
  templates     Template[]
  
  managerId     String?
  manager       User?      @relation("TenantManager", fields: [managerId], references: [id])
}

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  passwordHash  String
  name          String?
  phone         String?
  role          Role       @default(USER)
  tenantId      String?
  tenant        Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  isEmailVerified Boolean  @default(false)
  verificationToken String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  managedTenants Tenant[]  @relation("TenantManager")
  comments       EventComment[]
}

model Event {
  id                String       @id @default(uuid())
  tenantId          String
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  date              DateTime
  location          String
  reminderFrequency String?      @default("NONE") // NONE, DAILY, EVERY_3_DAYS, EVERY_5_DAYS, WEEKLY
  latitude          Float?
  longitude         Float?
  tablePlan         Json?        // Added for visual table planning
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  guests      Guest[]
  invitations Invitation[]
  shares      GuestShare[]
  posts       EventPost[]
}

model Guest {
  id          String       @id @default(uuid())
  eventId     String
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String
  email       String
  category    String?
  rsvp        String       @default("PENDING") // PENDING, ACCEPTED, DECLINED
  preferences Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  shares      GuestShare[]
  comments    EventComment[]

  @@unique([eventId, email])
}

model Template {
  id            String       @id @default(uuid())
  tenantId      String?
  tenant        Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  content       Json
  showOnLanding Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  invitations Invitation[]
}

model Invitation {
  id          String       @id @default(uuid())
  eventId     String
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  templateId  String?
  template    Template?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
  subject     String
  body        String
  channel     String       // EMAIL, LINK, QR
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model GuestShare {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guestId   String
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  message   String?
  photo     String?  // Base64 string (legacy)
  photos    Json?    // Array of Base64 strings for multiple photos
  createdAt DateTime @default(now())
}

model EventPost {
  id        String         @id @default(uuid())
  eventId   String
  event     Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  content   String?
  mediaUrl  String?        // Base64 string (legacy)
  mediaUrls Json?          // Array of objects { url: string, type: 'IMAGE' | 'VIDEO' }
  mediaType String?        // IMAGE, VIDEO, TEXT (legacy)
  createdAt DateTime       @default(now())
  comments  EventComment[]
}

model EventComment {
  id         String    @id @default(uuid())
  postId     String
  post       EventPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorName String
  guestId    String?
  guest      Guest?    @relation(fields: [guestId], references: [id], onDelete: SetNull)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  content    String
  createdAt  DateTime  @default(now())
}
